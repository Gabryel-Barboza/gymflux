# Copie para .env e ajuste (defaults = dev Linux com mock)
GYMFLUX_HENRY_MOCK=1
GYMFLUX_HENRY_DLL_PATH=vendor/kernel7x.dll
GYMFLUX_HENRY_PORTA=1
GYMFLUX_HENRY_TIMEOUT_MS=7000
GYMFLUX_DB_URL=sqlite:///data/gymflux.db
GYMFLUX_LOG_LEVEL=INFO

# Produção Windows 32-bit com catraca ligada (descomente no PC da recepção):
# GYMFLUX_HENRY_MOCK=0
# GYMFLUX_HENRY_DLL_PATH=C:\Program Files (x86)\Henry\Henry7x\Kernel7x.dll
# GYMFLUX_HENRY_PORTA=COM3
